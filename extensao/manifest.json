{
  "manifest_version": 3,
  "name": "Stream Deck",
  "version": "2.12.0",
  "description": "Deixa o Stream Deck caseiro ver as abas e controlar o navegador deste PC (só fala com o próprio PC).",
  "minimum_chrome_version": "110",
  "background": { "service_worker": "sw.js" },
  "action": { "default_popup": "popup.html", "default_title": "Stream Deck" },
  "options_ui": { "page": "popup.html", "open_in_tab": false },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*.youtube.com/*"
  ],
  "icons": { "16": "icones/icone-16.png", "32": "icones/icone-32.png", "48": "icones/icone-48.png",
             "128": "icones/icone-128.png" }
}
